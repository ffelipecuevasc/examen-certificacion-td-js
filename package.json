{
  "name": "guia-certificacion-fullstack-js",
  "version": "1.0.0",
  "type": "module",
  "description": "Guia de estudio para el examen de certificacion del Bootcamp Desarrollador FullStack JavaScript de Talento Digital para Chile.",
  "private": true,
  "author": "Felipe Cuevas (https://felipecuevas.dev)",
  "license": "MIT",
  "scripts": {
    "dev": "npm run icons && tailwindcss -i ./src/input.css -o ./static/css/style.css --watch",
    "build": "npm run icons && tailwindcss -i ./src/input.css -o ./static/css/style.css --minify && node scripts/build-dist.mjs",
    "verificar": "node scripts/verificar-todo.mjs",
    "serve": "npx serve .",
    "serve:dist": "npx serve dist",
    "datos:dev": "npm run build && wrangler pages dev",
    "datos:esquema": "wrangler d1 execute examen-td-js-produccion --local --file=d1/juguete.sql",
    "datos:migrar": "wrangler d1 execute examen-td-js-produccion --local --file=d1/migraciones/001-banco-de-preguntas.sql",
    "datos:migrar-002": "wrangler d1 execute examen-td-js-produccion --local --file=d1/migraciones/002-fecha-de-modificacion.sql",
    "datos:ejemplo": "wrangler d1 execute examen-td-js-produccion --local --file=d1/ejemplo-banco.sql",
    "datos:banco-local": "node scripts/banco-local.mjs",
    "datos:verificar-banco": "node scripts/verificar-banco.mjs",
    "datos:instantanea": "node scripts/generar-instantanea.mjs",
    "datos:publicar": "node scripts/publicar-banco.mjs",
    "banco:revisar": "node scripts/administrar-banco.mjs revisar",
    "banco:insertar": "node scripts/administrar-banco.mjs insertar",
    "banco:actualizar": "node scripts/administrar-banco.mjs actualizar",
    "start": "npm run dev",
    "icons": "node scripts/build-icons.mjs",
    "informe-banco": "node scripts/informe-banco.mjs",
    "verificar:barrera": "node scripts/verificar-barrera.mjs",
    "verificar:css": "node scripts/verificar.mjs",
    "probar:escapado": "node scripts/probar-escapado.mjs",
    "probar:filtrado": "node scripts/probar-filtrado.mjs",
    "probar:restricciones": "node scripts/probar-restricciones.mjs",
    "probar:instantanea": "node scripts/comprobar-instantanea.mjs"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17",
    "wrangler": "^4.128.0"
  }
}
