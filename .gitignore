# ==========================================
# COMPILACIÓN DE TAILWIND Y BUILDS
# ==========================================
# Directorios de salida (Si configuras Tailwind para exportar aquí)
# dist/ es el directorio que Cloudflare Pages publica. Lo arma scripts/build-dist.mjs
# en cada construcción, así que no se versiona. Ver ADR-010.
dist/
# build/
# out/

# Caché de bundlers (Vite, Parcel, Webpack, etc. por si los usas en el futuro)
.cache/
.parcel-cache/
dist-ssr/

